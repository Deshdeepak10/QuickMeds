# ArogyaSwift Real Production & Development Configuration
PORT=3000
NODE_ENV=development

# Database Settings (SQLite File Path)
DATABASE_URL=./arogyaswift.db

# Authentication Security (JWT Secret Key)
JWT_SECRET=arogyaswift-jwt-secret-key-change-in-prod-2026

# Gemini AI API Key (Powers AI OCR & Multilingual Chat Assistant)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Maps / Maps Proxy API Key (Optional: Falls back to OpenStreetMap / Google Embed)
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=5
RATE_LIMIT_AUTH_ACCOUNT_MAX=5
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_USER_MAX=300
