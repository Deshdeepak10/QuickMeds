# QuickMed Environment Variables Configuration Example
PORT=3000
NODE_ENV=development

# Frontend Forge API & Maps
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Rate Limiting Configuration (Configurable Thresholds)
# Window size in milliseconds (e.g. 900000ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Authentication Routes (Strict limits per IP & per Account with exponential backoff)
RATE_LIMIT_AUTH_IP_MAX=5
RATE_LIMIT_AUTH_ACCOUNT_MAX=5

# Public Endpoints (Moderate limits per IP)
RATE_LIMIT_PUBLIC_MAX=60

# Authenticated User Actions (Looser limits per User ID)
RATE_LIMIT_USER_MAX=300
